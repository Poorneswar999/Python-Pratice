'''
Given three numbers a, b and c. Find the greatest number among them.
Input: a = 10, b = 3, c = 2
Output: 10
'''
a,b,c = input().split(",")
a = int(a.split("=")[1])
b = int(b.split("=")[1])
c = int(c.split("=")[1])

if(a>b and a>c):
    print(a)
elif(b>c):
    print(b)
else:
    print(c)
